{
  "name": "dsh-auto-context-compression",
  "version": "0.1.0",
  "private": true,
  "description": "Proactive automatic context compression for DeepSeek Harness sessions.",
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check lib/index.js && node --check lib/policy.js && node --check lib/ws.js && node --check lib/bili.js && node --check lib/client-registration.js && node --check client.js && node --check tools/ws-probe.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./policy": "./lib/policy.js",
    "./ws": "./lib/ws.js",
    "./bili": "./lib/bili.js",
    "./client-registration": "./lib/client-registration.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/index.js",
    "lib/policy.js",
    "lib/ws.js",
    "lib/bili.js",
    "lib/client-registration.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "VERIFICATION.md",
    "VERIFICATION.en.md",
    "WEBSOCKET_REVIEW.md",
    "WEBSOCKET_REVIEW.en.md",
    "SECURITY_REVIEW.md",
    "SECURITY_REVIEW.en.md",
    "GITHUB.md",
    "GITHUB.en.md",
    "tools/ws-probe.mjs",
    "test/*.test.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
